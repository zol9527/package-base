{
  "app": {
    "name": "package-base",
    "version": "1.0.0",
    "mode": "development",
    "debug": true
  },
  "server": {
    "port": 8080,
    "host": "localhost",
    "read_timeout": 10,
    "write_timeout": 10,
    "idle_timeout": 120,
    "body_limit": "4MB",
    "prefork": false
  },
  "database": {
    "mysql": {
      "host": "localhost",
      "port": 3306,
      "username": "root",
      "password": "password",
      "database": "package_base",
      "charset": "utf8mb4",
      "parse_time": true,
      "loc": "Local",
      "max_open_conns": 100,
      "max_idle_conns": 10,
      "conn_max_lifetime": 3600,
      "conn_max_idle_time": 600,
      "log_level": "info"
    },
    "redis": {
      "host": "localhost",
      "port": 6379,
      "password": "",
      "database": 0,
      "max_retries": 3,
      "pool_size": 10,
      "min_idle_conns": 1,
      "dial_timeout": 5,
      "read_timeout": 3,
      "write_timeout": 3,
      "pool_timeout": 4,
      "idle_timeout": 300,
      "idle_check_freq": 60,
      "max_conn_age": 1800,
      "key_prefix": "auth:",
      "default_ttl": 86400
    }
  },
  "jwt": {
    "secret": "your-super-secret-jwt-key-change-in-production",
    "access_token_expire": 900,
    "refresh_token_expire": 86400,
    "issuer": "package-base",
    "enable_refresh_rotate": true
  },
  "security": {
    "password_min_length": 8,
    "max_login_attempts": 5,
    "lockout_duration": "30m",
    "enable_token_blacklist": true,
    "session_timeout": "24h",
    "bcrypt_cost": 12
  },
  "session": {
    "storage": "redis"
  },
  "logger": {
    "level": "info",
    "format": "json",
    "enable_file": true,
    "file_path": "./logs/app.log",
    "max_size": 100,
    "max_backups": 5,
    "max_age": 30,
    "compress": true,
    "local_time": true,
    "enable_console": true,
    "color_output": true,
    "enable_caller": true,
    "enable_stacktrace": false
  },
  "logto": {
    "endpoint": "https://api.logto.io",
    "api_key": "your-api-key",
    "app_id": "your-app-id",
    "redirect_uri": "http://localhost:8080/callback"
  }
}
